# Twitch chat account that sends bot replies.
TWITCH_USERNAME=your_bot_or_channel_username

# OAuth token from https://twitchtokengenerator.com/
# Use only the chat:read and chat:edit scopes.
# Keep the oauth: prefix.
TWITCH_OAUTH=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twitch channel without #.
TWITCH_CHANNEL=your_channel

# Optional local web server port for the OBS/browser queue.
PORT=3000

# Optional comma-separated broadcaster/mod usernames allowed to run mod commands.
MOD_USERS=your_channel

# Optional game filters. Example: 2025,2026,plus
ENABLED_GAMES=2023,2024,2025,2026,plus

# Optional queue display limit.
MAX_QUEUE_SIZE=50
