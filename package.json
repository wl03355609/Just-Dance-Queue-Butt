{
  "name": "just-dance-requests-twitch",
  "version": "0.7.10",
  "codename": "Alternate Reality",
  "description": "A local Twitch chat song request queue for Just Dance streamers.",
  "main": "desktop/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "desktop": "electron .",
    "check": "node --check src/index.js && node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/renderer.js",
    "build:win": "electron-builder --win --ia32"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "twitch",
    "just-dance",
    "song-requests",
    "obs"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.justdancerequests.twitch",
    "productName": "Just Dance Requests",
    "icon": "build/icon.ico",
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "data/songs.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "JustDanceRequests-0.7.10-x86.exe"
    }
  }
}
